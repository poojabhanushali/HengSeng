# ==============================================================================
# HengSeng Sentiment Price Prediction Agent - Environment Configuration
# ==============================================================================

# Application Environment & Security
APP_ENV=development
PORT=3000
SECRET_KEY=generate_a_secure_random_key_here
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database & Cache Configuration (PostgreSQL + Redis)
DATABASE_URL=postgresql://hengseng:hengseng_secure_pass@localhost:5432/hengseng_db
REDIS_URL=redis://localhost:6379/0

# Apify Social Media Scraping Integration
# Obtain token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_LIHKG_ACTOR_ID=apify/lihkg-scraper
APIFY_TELEGRAM_ACTOR_ID=apify/telegram-scraper
APIFY_NAVER_ACTOR_ID=apify/naver-finance-scraper
APIFY_DAUM_ACTOR_ID=apify/daum-forum-scraper

# Exa Financial News Discovery Engine
# Obtain API key from: https://dashboard.exa.ai/api-keys
EXA_API_KEY=80152f87-d6e1-47b2-ae04-fcbc3377e76a

# Market Data Feed Provider
# Options: "Yahoo Finance (Direct)", "Alpha Vantage", "Twelve Data"
MARKET_DATA_PROVIDER="Yahoo Finance (Direct)"
MARKET_DATA_API_KEY=

# Google AI Studio / Gemini Integration (auto-injected in AI Studio)
GEMINI_API_KEY=
APP_URL=

